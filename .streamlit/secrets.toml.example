# Sadhana Setu — Streamlit secrets template
#
# Copy this to .streamlit/secrets.toml (gitignored) and fill in the values
# from your Google Cloud Console OAuth client. See docs/GDRIVE_SETUP.md.
#
# When deployed to Streamlit Cloud, paste the same TOML into
# https://share.streamlit.io → your app → Settings → Secrets.

[google_oauth]
client_id = "YOUR_CLIENT_ID.apps.googleusercontent.com"
client_secret = "YOUR_CLIENT_SECRET"

# For local development:
redirect_uri = "http://localhost:8501/"

# For Streamlit Cloud, override locally to:
# redirect_uri = "https://<your-app>.streamlit.app/"
