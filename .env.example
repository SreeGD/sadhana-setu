# Sadhana Setu — environment configuration
# Copy this file to .env and adjust paths to match your machine.

# SQLite database file (default: ./data/sadhana_setu.db)
SADHANA_SETU_DB=./data/sadhana_setu.db

# vidya-karana-kg MCP server. Paths from the kg-mcp install.
KG_MCP_BIN=/Users/sree/Projects/vidya-karana-kg/.venv/bin/kg-mcp
SNAPSHOT_DIR=/Users/sree/Projects/vidya-karana-kg/data/snapshots
CHROMADB_PATH=/Users/sree/Projects/vidya-karana/chromadb
VIDYA_KARANA_ROOT=/Users/sree/Projects/vidya-karana
